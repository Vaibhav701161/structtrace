{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://structtrace.dev/schemas/structtrace.schema.json",
  "title": "StructTrace configuration",
  "type": "object",
  "required": ["version", "project", "dataset", "schema", "variants", "outcomes", "analysis"],
  "additionalProperties": false,
  "properties": {
    "version": {"const": 3},
    "project": {
      "type": "object",
      "required": ["name"],
      "additionalProperties": false,
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "description": {"type": "string"}
      }
    },
    "storage": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "root": {"type": "string", "default": ".structtrace"},
        "retain_raw_outputs": {"type": "boolean", "default": true},
        "retain_provider_responses": {"type": "boolean", "default": false},
        "process_logs": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "mode": {"enum": ["off", "sanitized", "full_sensitive"], "default": "off"},
            "max_total_bytes": {"type": "integer", "minimum": 1, "maximum": 67108864, "default": 4194304},
            "custom_patterns": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true}
          }
        },
        "redaction": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "json_pointers": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
            "text_mode": {"enum": ["exact_structured", "aggressive_textual"], "default": "exact_structured"},
            "custom_patterns": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true}
          }
        }
      }
    },
    "limits": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "max_config_bytes": {"type": "integer", "minimum": 1, "maximum": 16777216, "default": 1048576},
        "max_dataset_bytes": {"type": "integer", "minimum": 1, "maximum": 1073741824, "default": 33554432},
        "max_recorded_output_bytes": {"type": "integer", "minimum": 1, "maximum": 2147483648, "default": 33554432},
        "max_schema_bytes": {"type": "integer", "minimum": 1, "maximum": 67108864, "default": 16777216},
        "max_cases": {"type": "integer", "minimum": 1, "maximum": 100000, "default": 10000},
        "max_jsonl_line_bytes": {"type": "integer", "minimum": 1, "maximum": 67108864, "default": 16777216},
        "max_replay_artifact_bytes": {"type": "integer", "minimum": 1, "maximum": 2147483648, "default": 536870912},
        "max_output_bytes_per_case": {"type": "integer", "minimum": 1, "maximum": 67108864, "default": 4194304},
        "max_stderr_bytes_per_process": {"type": "integer", "minimum": 1, "maximum": 16777216, "default": 1048576},
        "max_report_raw_bytes_per_case": {"type": "integer", "minimum": 1, "maximum": 4194304, "default": 262144},
        "max_report_total_bytes": {"type": "integer", "minimum": 1, "maximum": 1073741824, "default": 268435456},
        "max_single_file_report_bytes": {"type": "integer", "minimum": 1, "maximum": 104857600, "default": 10485760}
      }
    },
    "dataset": {
      "type": "object",
      "required": ["path"],
      "additionalProperties": false,
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "format": {"const": "jsonl", "default": "jsonl"},
        "fields": {"$ref": "#/$defs/datasetFields"},
        "evidence_unit": {"$ref": "#/$defs/evidenceUnit"}
      }
    },
    "schema": {
      "type": "object",
      "required": ["path"],
      "additionalProperties": false,
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "provenance": {"enum": ["caller_supplied", "inferred_expected_shape"], "default": "caller_supplied"}
      }
    },
    "variants": {
      "type": "object",
      "required": ["baseline", "candidate"],
      "additionalProperties": false,
      "properties": {
        "baseline": {"$ref": "#/$defs/variant"},
        "candidate": {"$ref": "#/$defs/variant"}
      }
    },
    "evaluators": {
      "type": "array",
      "items": {"$ref": "#/$defs/evaluator"}
    },
    "outcomes": {
      "type": "object",
      "propertyNames": {"minLength": 1},
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "oneOf": [{"required": ["all_of"]}, {"required": ["any_of"]}],
        "properties": {
          "all_of": {"type": "array", "items": {"type": "string"}, "minItems": 1},
          "any_of": {"type": "array", "items": {"type": "string"}, "minItems": 1}
        }
      }
    },
    "analysis": {
      "type": "object",
      "required": ["primary_outcome"],
      "additionalProperties": false,
      "properties": {
        "primary_outcome": {"type": "string", "minLength": 1},
        "bootstrap": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "samples": {"type": "integer", "minimum": 1, "maximum": 1000000, "default": 10000},
            "confidence": {"type": "number", "exclusiveMinimum": 0, "exclusiveMaximum": 1, "default": 0.95},
            "seed": {"type": "integer", "minimum": 0, "default": 17}
          }
        }
      }
    },
    "gate": {
      "type": "object",
      "additionalProperties": false,
      "allOf": [
        {
          "if": {"properties": {"mode": {"enum": ["regression", "release"]}}, "required": ["mode"]},
          "then": {
            "required": ["min_cases", "min_unique_cases", "max_duplicate_case_rate", "min_primary_fully_evaluated_rate", "max_primary_component_error_rate", "max_primary_component_not_applicable_rate", "max_primary_component_unscored_rate"],
            "anyOf": [
              {"required": ["max_primary_regression_pp"]},
              {"required": ["max_deployment_regression_pp"]},
              {"required": ["max_valid_but_wrong_increase_pp"]},
              {"required": ["max_upper_confidence_bound_regression_pp"]},
              {"required": ["max_upper_confidence_bound_deployment_regression_pp"]}
            ]
          }
        },
        {
          "if": {"properties": {"mode": {"const": "release"}}, "required": ["mode"]},
          "then": {
            "required": ["max_deployment_regression_pp", "min_candidate_deployment_success_rate", "min_candidate_parse_validity", "min_candidate_schema_validity", "max_candidate_valid_but_wrong_rate"],
            "properties": {
              "min_cases": {"type": "integer", "minimum": 100},
              "min_unique_cases": {"type": "integer", "minimum": 100},
              "max_duplicate_case_rate": {"type": "number", "maximum": 0.01},
              "min_primary_fully_evaluated_rate": {"type": "number", "minimum": 0.99},
              "max_primary_component_error_rate": {"type": "number", "maximum": 0.01},
              "max_primary_component_not_applicable_rate": {"const": 0},
              "max_primary_component_unscored_rate": {"const": 0},
              "max_deployment_regression_pp": {"type": "number", "maximum": 1.0},
              "min_candidate_deployment_success_rate": {"type": "number", "minimum": 0.95},
              "min_candidate_parse_validity": {"type": "number", "minimum": 0.99},
              "min_candidate_schema_validity": {"type": "number", "minimum": 0.99},
              "max_candidate_valid_but_wrong_rate": {"type": "number", "maximum": 0.02}
            }
          }
        }
      ],
      "properties": {
        "mode": {"enum": ["advisory", "regression", "release"], "default": "advisory"},
        "min_cases": {"type": ["integer", "null"], "minimum": 1},
        "min_unique_cases": {"type": ["integer", "null"], "minimum": 1},
        "max_duplicate_case_rate": {"type": ["number", "null"], "minimum": 0, "maximum": 1},
        "min_primary_fully_evaluated_rate": {"type": ["number", "null"], "minimum": 0, "maximum": 1},
        "max_primary_component_error_rate": {"type": ["number", "null"], "minimum": 0, "maximum": 1},
        "max_primary_component_not_applicable_rate": {"type": ["number", "null"], "minimum": 0, "maximum": 1},
        "max_primary_component_unscored_rate": {"type": ["number", "null"], "minimum": 0, "maximum": 1},
        "max_primary_regression_pp": {"type": ["number", "null"], "minimum": 0},
        "max_deployment_regression_pp": {"type": ["number", "null"], "minimum": 0},
        "max_valid_but_wrong_increase_pp": {"type": ["number", "null"], "minimum": 0},
        "min_candidate_primary_success_rate": {"type": ["number", "null"], "minimum": 0, "maximum": 1},
        "min_candidate_deployment_success_rate": {"type": ["number", "null"], "minimum": 0, "maximum": 1},
        "max_candidate_valid_but_wrong_rate": {"type": ["number", "null"], "minimum": 0, "maximum": 1},
        "min_candidate_parse_validity": {"type": ["number", "null"], "minimum": 0, "maximum": 1},
        "max_upper_confidence_bound_regression_pp": {"type": ["number", "null"], "minimum": 0},
        "max_upper_confidence_bound_deployment_regression_pp": {"type": ["number", "null"], "minimum": 0},
        "min_discordant_pairs": {"type": ["integer", "null"], "minimum": 1},
        "min_candidate_schema_validity": {"type": ["number", "null"], "minimum": 0, "maximum": 1},
        "max_error_rate": {"type": ["number", "null"], "minimum": 0, "maximum": 1},
        "max_timeout_rate": {"type": ["number", "null"], "minimum": 0, "maximum": 1},
        "latency": {"type": ["object", "null"], "required": ["max_p95_increase_percent"], "additionalProperties": false, "properties": {"max_p95_increase_percent": {"type": "number", "minimum": 0}, "min_coverage": {"type": "number", "minimum": 0, "maximum": 1, "default": 1}}},
        "cost": {"type": ["object", "null"], "required": ["max_average_increase_percent"], "additionalProperties": false, "properties": {"max_average_increase_percent": {"type": "number", "minimum": 0}, "min_coverage": {"type": "number", "minimum": 0, "maximum": 1, "default": 1}}}
      }
    },
    "report": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "title": {"type": ["string", "null"]},
        "include_raw_outputs": {"type": "boolean", "default": true},
        "include_prompts": {"type": "boolean", "default": false},
        "search_pointers": {"type": "array", "items": {"type": "string", "pattern": "^(|/(?:[^~]|~[01])*)$"}, "maxItems": 32, "uniqueItems": true},
        "default_case_filter": {"enum": ["all", "discordant", "baseline_only_pass", "candidate_only_pass", "both_fail", "valid_but_wrong", "parse_failure", "schema_failure", "adapter_error", "evaluator_error", "not_applicable", "unscored"], "default": "discordant"}
      }
    }
  },
  "$defs": {
    "datasetFields": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {"type": "string", "default": "/id"},
        "input": {"type": "string", "default": "/input"},
        "expected": {"type": "string", "default": "/expected"},
        "model_visible_metadata": {"type": "string", "default": "/model_visible_metadata"},
        "metadata": {"type": "string", "default": "/metadata"}
      }
    },
    "evidenceUnit": {
      "type": "object",
      "additionalProperties": false,
      "oneOf": [
        {"required": ["pointer"], "not": {"required": ["include"]}},
        {"required": ["include"], "not": {"required": ["pointer"]}}
      ],
      "properties": {
        "pointer": {"type": "string"},
        "include": {"type": "array", "items": {"type": "string"}, "minItems": 1, "uniqueItems": true}
      }
    },
    "commandSpec": {
      "type": "object",
      "required": ["program"],
      "additionalProperties": false,
      "properties": {
        "program": {"type": "string", "minLength": 1},
        "args": {"type": "array", "items": {"type": "string"}}
      }
    },
    "implementation": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "digest": {"type": ["string", "null"], "minLength": 1},
        "sources": {"type": "array", "items": {"type": "string", "minLength": 1}, "maxItems": 256, "uniqueItems": true}
      }
    },
    "variant": {
      "oneOf": [
        {"type": "object", "required": ["kind", "path"], "additionalProperties": false, "properties": {"kind": {"const": "recorded"}, "path": {"type": "string", "minLength": 1}}},
        {"type": "object", "required": ["kind", "command"], "additionalProperties": false, "properties": {"kind": {"const": "command"}, "command": {"$ref": "#/$defs/commandSpec"}, "process_mode": {"enum": ["persistent", "per_case"], "default": "persistent"}, "timeout_ms": {"type": "integer", "minimum": 1, "maximum": 86400000}, "implementation": {"$ref": "#/$defs/implementation"}}},
        {"type": "object", "required": ["kind", "callable"], "additionalProperties": false, "properties": {"kind": {"const": "python"}, "interpreter": {"type": "string", "minLength": 1}, "callable": {"type": "string", "pattern": "^[^:]+:[^:]+$"}, "timeout_ms": {"type": "integer", "minimum": 1, "maximum": 86400000}, "implementation": {"$ref": "#/$defs/implementation"}}},
        {"$ref": "#/$defs/openaiVariant"}
      ]
    },
    "openaiVariant": {
      "type": "object",
      "required": ["kind", "base_url", "model", "request"],
      "additionalProperties": false,
      "properties": {
        "kind": {"const": "openai_compatible"},
        "base_url": {"type": "string", "format": "uri", "pattern": "^https?://[^/?#@]+(?:/[^?#]*)?$", "not": {"pattern": "/chat/completions/?$"}},
        "api_key_env": {"type": ["string", "null"], "minLength": 1},
        "model": {"type": "string", "minLength": 1},
        "request": {"type": "object", "required": ["user_template"], "additionalProperties": false, "properties": {"system": {"type": ["string", "null"]}, "user_template": {"type": "string", "minLength": 1}, "temperature": {"type": "number", "minimum": 0, "maximum": 2, "default": 0}, "max_output_tokens": {"type": "integer", "minimum": 1, "maximum": 1000000, "default": 500}}},
        "structured_output": {"type": ["object", "null"], "required": ["mode"], "additionalProperties": false, "properties": {"mode": {"enum": ["json_schema", "json_object"]}, "schema": {"type": ["string", "null"], "minLength": 1}}},
        "timeout_ms": {"type": "integer", "minimum": 1, "maximum": 86400000},
        "concurrency": {"type": "integer", "minimum": 1, "maximum": 256},
        "retries": {"type": "integer", "minimum": 0, "maximum": 20},
        "pricing": {"type": ["object", "null"], "required": ["input_per_million", "output_per_million", "currency"], "additionalProperties": false, "properties": {"input_per_million": {"type": "string"}, "output_per_million": {"type": "string"}, "currency": {"type": "string"}}}
      }
    },
    "pointerPair": {
      "type": "object",
      "required": ["pointer", "expected_pointer"],
      "additionalProperties": false,
      "properties": {"pointer": {"type": "string"}, "expected_pointer": {"type": "string"}}
    },
    "evaluator": {
      "oneOf": [
        {"type": "object", "required": ["id", "kind"], "additionalProperties": false, "properties": {"id": {"type": "string"}, "kind": {"const": "exact_json"}}},
        {"type": "object", "required": ["id", "kind", "pointer", "expected_pointer"], "additionalProperties": false, "properties": {"id": {"type": "string"}, "kind": {"enum": ["json_pointer_exact", "enum_accuracy"]}, "pointer": {"type": "string"}, "expected_pointer": {"type": "string"}}},
        {"type": "object", "required": ["id", "kind", "pointer", "expected_pointer"], "additionalProperties": false, "properties": {"id": {"type": "string"}, "kind": {"const": "normalized_string"}, "pointer": {"type": "string"}, "expected_pointer": {"type": "string"}, "case_insensitive": {"type": "boolean", "default": true}}},
        {"type": "object", "required": ["id", "kind", "pointer", "expected_pointer"], "additionalProperties": false, "properties": {"id": {"type": "string", "minLength": 1}, "kind": {"const": "canonical_date"}, "pointer": {"type": "string"}, "expected_pointer": {"type": "string"}, "formats": {"type": "array", "items": {"enum": ["iso", "dmy_slash", "mdy_slash"]}, "minItems": 1}}, "allOf": [{"not": {"required": ["formats"], "properties": {"formats": {"allOf": [{"contains": {"const": "dmy_slash"}}, {"contains": {"const": "mdy_slash"}}]}}}}]},
        {"type": "object", "required": ["id", "kind", "pointers"], "additionalProperties": false, "properties": {"id": {"type": "string"}, "kind": {"enum": ["json_pointers_exact", "tool_arguments"]}, "pointers": {"type": "array", "items": {"$ref": "#/$defs/pointerPair"}, "minItems": 1}}},
        {"type": "object", "required": ["id", "kind", "pointer", "expected_pointer"], "additionalProperties": false, "properties": {"id": {"type": "string"}, "kind": {"const": "numeric_tolerance"}, "pointer": {"type": "string"}, "expected_pointer": {"type": "string"}, "absolute": {"type": ["string", "null"]}, "relative": {"type": ["string", "null"]}, "exact_integer": {"type": "boolean"}}},
        {"type": "object", "required": ["id", "kind", "pointers"], "additionalProperties": false, "properties": {"id": {"type": "string"}, "kind": {"const": "required_fields"}, "pointers": {"type": "array", "items": {"type": "string"}, "minItems": 1}}},
        {"type": "object", "required": ["id", "kind"], "additionalProperties": false, "properties": {"id": {"type": "string"}, "kind": {"const": "tool_selection"}, "pointer": {"type": "string"}, "expected_pointer": {"type": "string"}}},
        {"type": "object", "required": ["id", "kind", "pointer", "expected_pointer", "keys", "fields"], "additionalProperties": false, "properties": {"id": {"type": "string"}, "kind": {"const": "keyed_array"}, "pointer": {"type": "string"}, "expected_pointer": {"type": "string"}, "keys": {"type": "array", "items": {"type": "string"}, "minItems": 1}, "key_fields": {"type": "array", "items": {"$ref": "#/$defs/keyedIdentityField"}}, "fields": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/keyedArrayField"}}}},
        {"type": "object", "required": ["id", "kind"], "additionalProperties": false, "properties": {"id": {"type": "string"}, "kind": {"const": "financial_invariants"}, "line_items_pointer": {"type": "string"}, "quantity_pointer": {"type": "string"}, "unit_price_pointer": {"type": "string"}, "amount_pointer": {"type": "string"}, "subtotal_pointer": {"type": "string"}, "tax_pointer": {"type": "string"}, "total_pointer": {"type": "string"}, "absolute": {"type": "string"}}},
        {"type": "object", "required": ["id", "implementation_version", "kind", "command"], "additionalProperties": false, "properties": {"id": {"type": "string", "minLength": 1}, "implementation_version": {"type": "string", "minLength": 1}, "kind": {"const": "command"}, "command": {"$ref": "#/$defs/commandSpec"}, "process_mode": {"const": "persistent", "default": "persistent"}, "timeout_ms": {"type": "integer", "minimum": 1, "maximum": 86400000}, "implementation": {"$ref": "#/$defs/implementation"}}},
        {"type": "object", "required": ["id", "implementation_version", "kind", "callable"], "additionalProperties": false, "properties": {"id": {"type": "string", "minLength": 1}, "implementation_version": {"type": "string", "minLength": 1}, "kind": {"const": "python"}, "interpreter": {"type": "string", "minLength": 1}, "callable": {"type": "string", "pattern": "^[^:]+:[^:]+$"}, "process_mode": {"const": "persistent", "default": "persistent"}, "timeout_ms": {"type": "integer", "minimum": 1, "maximum": 86400000}, "implementation": {"$ref": "#/$defs/implementation"}}}
      ]
    },
    "keyedIdentityField": {
      "type": "object",
      "required": ["pointer", "evaluator"],
      "additionalProperties": false,
      "allOf": [{"if": {"properties": {"evaluator": {"const": "canonical_date"}}}, "then": {"required": ["formats"], "not": {"properties": {"formats": {"allOf": [{"contains": {"const": "dmy_slash"}}, {"contains": {"const": "mdy_slash"}}]}}}}}],
      "properties": {
        "pointer": {"type": "string"},
        "evaluator": {"enum": ["exact", "normalized_string", "exact_integer", "canonical_date"]},
        "case_insensitive": {"type": "boolean", "default": true},
        "formats": {"type": "array", "items": {"enum": ["iso", "dmy_slash", "mdy_slash"]}, "minItems": 1}
      }
    },
    "keyedArrayField": {
      "type": "object",
      "required": ["pointer", "evaluator"],
      "additionalProperties": false,
      "allOf": [{"if": {"properties": {"evaluator": {"const": "canonical_date"}}}, "then": {"not": {"required": ["formats"], "properties": {"formats": {"allOf": [{"contains": {"const": "dmy_slash"}}, {"contains": {"const": "mdy_slash"}}]}}}}}],
      "properties": {
        "pointer": {"type": "string"},
        "evaluator": {"enum": ["exact", "normalized_string", "exact_integer", "decimal_exact", "decimal_tolerance", "canonical_date"]},
        "absolute": {"type": ["string", "null"]},
        "case_insensitive": {"type": "boolean", "default": true},
        "formats": {"type": "array", "items": {"enum": ["iso", "dmy_slash", "mdy_slash"]}}
      }
    }
  }
}
