---
import "../styles/global.css";

interface Props {
  title: string;
  description: string;
  image?: string;
}

const {
  title,
  description,
  image = "/social/structtrace-og.png",
} = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
const active = Astro.url.pathname;
const nav = [
  ["Product", "/product"],
  ["Use cases", "/use-cases"],
  ["Try", "/try"],
  ["Research", "/research"],
  ["Docs", "/docs"],
  ["Security", "/security"],
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#f1eee8" />
    <meta name="color-scheme" content="light dark" />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="StructTrace" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={new URL(image, Astro.site)} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={new URL(image, Astro.site)} />
    <title>{title}</title>
    <script is:inline src="/scripts/site.js" defer></script>
  </head>
  <body itemscope itemtype="https://schema.org/SoftwareApplication">
    <meta itemprop="name" content="StructTrace" />
    <meta itemprop="applicationCategory" content="DeveloperApplication" />
    <meta itemprop="operatingSystem" content="Linux, macOS, Windows" />
    <meta itemprop="softwareVersion" content="0.1.0" />
    <a class="skip-link" href="#main">Skip to content</a>
    <header class="site-header">
      <div class="header-inner">
        <a class="wordmark" href="/" aria-label="StructTrace home">
          <img src="/assets/structtrace-logo-mark.svg" width="32" height="32" alt="" />
          <span>StructTrace</span>
        </a>
        <button class="nav-toggle" type="button" aria-expanded="false" aria-controls="site-nav">
          <span class="sr-only">Open navigation</span><i></i><i></i>
        </button>
        <nav id="site-nav" class="site-nav" aria-label="Primary navigation">
          {nav.map(([label, href]) => <a href={href} aria-current={active === href || (href !== "/" && active.startsWith(`${href}/`)) ? "page" : undefined}>{label}</a>)}
          <a class="nav-download" href="/download">Download</a>
        </nav>
      </div>
    </header>
    <main id="main"><slot /></main>
    <footer class="site-footer">
      <div class="footer-grid">
        <div>
          <a class="wordmark footer-mark" href="/"><img src="/assets/structtrace-logo-mark.svg" width="30" height="30" alt="" /><span>StructTrace</span></a>
          <p>Paired release evidence for structured-output systems. Local by design.</p>
        </div>
        <div><strong>Product</strong><a href="/product">How it works</a><a href="/try">Invoice demo</a><a href="/download">Download</a></div>
        <div><strong>Trust</strong><a href="/research">Research</a><a href="/security">Security</a><a href="/privacy">Privacy</a></div>
        <div><strong>Build</strong><a href="/docs">Documentation</a><a href="https://github.com/Vaibhav701161/structtrace">GitHub</a><a href="https://github.com/Vaibhav701161/structtrace/issues">Issues</a></div>
      </div>
      <div class="footer-bottom"><span>MIT licensed</span><span>No accounts. No telemetry. No evaluation data upload.</span></div>
    </footer>
  </body>
</html>
